.cursor/
workspace/
bin/
demo_data/
extra/
ai-docs/

# Generated local native dependencies and build outputs.
/build/artifacts/**
!/build/artifacts/.gitkeep
/build/deps/
/build/cargo/
/build/faiss/
/build/native/
/native/fffbridge/target/
/lib/*.a
/lib/*.so
/lib/*.dll

# Local indexes and evidence artifacts are rebuildable and may contain corpus metadata.
*.vvfs-search/
*.vvfs-search.evidence/
*.memory.evidence/
*.bleve/
/search-data/

# Preserve pre-existing local model/database files without tracking them.
/vvfs/generation/models/gguf/
/vvfs/memory/migrations/test.db

/release/
