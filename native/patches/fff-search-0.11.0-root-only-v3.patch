+/// Filesystem policy selected before any picker scan starts.
+///
+/// This is not an OS sandbox. Callers must keep the absolute, non-symlink root,
+/// its ancestry, mounts and indexed paths stable against adversarial replacement,
+/// and must not mutate the picker's public `base_path` after construction.
+#[derive(Debug, Clone, Copy, Default, PartialEq, Eq)]
+pub enum ReadPolicy {
+    /// Existing Git discovery, status, history and ignore-file behavior.
+    #[default]
+    Ambient,
+    /// No Git operations or ignore-file interpretation, including root-local
+    /// `.ignore` and `.gitignore`. Those files are ordinary searchable files.
+    /// Includes hidden files but excludes `.git` entries and all symlinks.
+    /// Requires the ripgrep backend and `follow_symlinks: false`.
+    RootOnly,
+}
+
+impl ReadPolicy {
+    pub(crate) fn allows_path(self, base: &Path, path: &Path) -> bool {
+        if self == Self::Ambient {
+            return true;
+        }
+        let Ok(relative) = path.strip_prefix(base) else {
+            return false;
+        };
+        // Validate the entire lexical path before a missing component can
+        // short-circuit metadata checks for removal events.
+        if relative.components().any(
+            |component| !matches!(component, std::path::Component::Normal(name) if name != ".git"),
+        ) {
+            return false;
+        }
+        let mut current = base.to_path_buf();
+        for component in relative.components() {
+            let std::path::Component::Normal(name) = component else {
+                return false;
+            };
+            current.push(name);
+            match std::fs::symlink_metadata(&current) {
+                Ok(metadata) if metadata.file_type().is_symlink() => return false,
+                Ok(_) => {}
+                // A removal event needs no read of the missing leaf.
+                Err(error) if error.kind() == std::io::ErrorKind::NotFound => return true,
+                Err(_) => return false,
+            }
+        }
+        true
+    }
+}
