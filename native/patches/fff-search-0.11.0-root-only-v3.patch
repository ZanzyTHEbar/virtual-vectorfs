+/// Completion fence for a scan reserved after this request, bound to one picker.
+/// A later successfully completed scan may satisfy coalesced earlier requests.
+#[derive(Clone)]
+pub struct RescanTicket {
+    signals: ScanSignals,
+    sequence: u64,
+}
+
+impl std::fmt::Debug for RescanTicket {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("RescanTicket")
+            .field("sequence", &self.sequence)
+            .finish()
+    }
+}
+
+impl RescanTicket {
+    /// Monotonic request identity, scoped to the picker which issued the ticket.
+    pub fn sequence(&self) -> u64 {
+        self.sequence
+    }
+
+    /// Wait for this request's successful native scan, not a sample of idle flags.
+    /// Returns false on timeout; cancellation or scan failure returns an error.
+    pub fn wait(&self, timeout: Duration) -> Result<bool, Error> {
+        let start = Instant::now();
+        loop {
+            {
+                let state = self.signals.scheduler.lock();
+                if state.completed >= self.sequence {
+                    return Ok(true);
+                }
+                if state.failed_through >= self.sequence
+                    || self.signals.cancelled.load(Ordering::Acquire)
+                {
+                    return Err(Error::ScanRequestFailed(
+                        "requested scan failed or picker was cancelled",
+                    ));
+                }
+            }
+            let remaining = timeout.saturating_sub(start.elapsed());
+            if remaining.is_zero() {
+                return Ok(false);
+            }
+            std::thread::sleep(remaining.min(Duration::from_millis(10)));
+        }
+    }
 }
 
